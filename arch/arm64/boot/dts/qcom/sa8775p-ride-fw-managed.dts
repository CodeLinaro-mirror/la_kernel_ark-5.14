/dts-v1/;

#include <dt-bindings/gpio/gpio.h>

#include "sa8775p.dtsi"
#include "sa8775p-pmics.dtsi"
#include "sa8775p-scmi.dtsi"

/ {
	model = "Qualcomm Technologies, Inc. SA8775P Ride Firmware Managed";
	compatible = "qcom,sa8775p-ride-fw-managed";

	aliases {
		ethernet0 = &ethernet0;
		ethernet1 = &ethernet1;
		i2c11 = &i2c11;
		i2c18 = &i2c18;
		serial0 = &uart10;
		serial1 = &uart4;
		serial2 = &uart17;
		spi16 = &spi16;
		ufshc1 = &ufs_mem_hc;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	gpll0_board_clk: gpll0-board-clk {
		compatible = "fixed-clock";
		clock-frequency = <300000000>;
		#clock-cells = <0>;
	};

	/delete-node/ reboot-mode;
};

/* deleting nodes not needed for fw-managed variant */

/delete-node/ &apps_rsc;
/delete-node/ &gcc;
/delete-node/ &gpucc;
/delete-node/ &aggre1_noc;
/delete-node/ &aggre2_noc;
