	compatible = "qcom,geni-debug-uart";
	pinctrl-0 = <&qup_uart10_default>;
	pinctrl-names = "default";
	power-domains = <&scmi11_pd 10>, <&scmi11_dvfs 10>;
	power-domain-names = "power", "perf";
