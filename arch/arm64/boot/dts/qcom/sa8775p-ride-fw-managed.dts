/delete-node/ &nspb_noc;
/delete-node/ &pcie_anoc;
/delete-node/ &system_noc;
/delete-node/ &spmi_bus;
/delete-node/ &qup_opp_table_100mhz;
/delete-node/ &ufs_mem_phy;
/delete-node/ &serdes0;
/delete-node/ &serdes1;

/* deleting nodes not yet migrated to fw-managed variant */

/delete-node/ &pcie0_ep;
/delete-node/ &pcie1_ep;
/delete-node/ &pcie0_phy;
/delete-node/ &pcie1_phy;

